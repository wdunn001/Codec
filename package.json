{
  "name": "codec",
  "version": "0.1.0",
  "description": "Token-native binary transport protocol for AI APIs",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/mcp-leaf/examples/time-server"
  ],
  "scripts": {
    "demo": "tsx packages/demo/src/benchmark.ts",
    "demo:agent": "tsx packages/demo/src/agent.ts",
