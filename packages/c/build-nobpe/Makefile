# target to build an object file
src/stream.c.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/codec_static.dir/build.make CMakeFiles/codec_static.dir/src/stream.c.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/codec_shared.dir/build.make CMakeFiles/codec_shared.dir/src/stream.c.o
.PHONY : src/stream.c.o

