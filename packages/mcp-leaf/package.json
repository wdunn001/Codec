{
  "name": "@codecai/mcp-leaf",
  "version": "0.3.2",
  "description": "Codec-aware MCP leaf helper. Annotates each text content block with a per-block _meta['ai.codec/leaf-tokenization'] payload so a Codec-aware gateway (or client) skips re-tokenization. The thin layer between an MCP tool author and the leaf-mode contract in Codec spec § Tool-call calling conventions in the map.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@codecai/web": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "codec",
    "mcp",
    "tokenizer",
    "leaf",
    "tool-call",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdunn001/Codec.git",
    "directory": "packages/mcp-leaf"
  },
  "homepage": "https://github.com/wdunn001/Codec/tree/main/packages/mcp-leaf"
}
