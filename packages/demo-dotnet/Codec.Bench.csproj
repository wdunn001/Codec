<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Lab boxes (where the matrix bench runs) currently ship .NET SDK 9.x
         which cannot evaluate a net10.0 TargetFrameworks entry; the test
         project under ../dotnet/test bumped to net10.0 for local dev
         parity is OK because it is never built in the bench path.
         Pin this bin to net8.0 only: dev boxes without .NET 8 SDK can
         install it via dotnet-install channel 8.0. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Codec.Bench</RootNamespace>
    <AssemblyName>codec-bench</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\dotnet\src\Codec.Net\Codec.Net.csproj" />
    <!-- Pure-C# port of libzstd. Supports pre-trained dictionaries via
         Decompressor.LoadDictionary (matches the Codec-Zstd-Dict contract
         in spec/PROTOCOL.md). Avoids the native libzstd dependency that
         ZstdNet pulls in, so the bench runs identically on Windows /
         Linux / macOS lab boxes without extra OS packages. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
