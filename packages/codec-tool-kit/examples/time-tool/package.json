{
  "name": "@codecai/codec-time-tool",
  "version": "0.5.0",
  "description": "Reference Codec-native bolt-on tool built on @codecai/tool-kit. Returns the current UTC time as pre-cached token IDs — the gateway memcpy's the response into the model's generation context with no detokenize/retokenize anywhere on the hot path. The canonical demo of the precache-at-build-time pattern.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codec-time-tool": "./dist/index.js"
  },
  "files": [
    "dist",
    "cache",
    "manifest.json",
    "README.md"
  ],
  "scripts": {
    "build:cache": "tsx scripts/build-cache.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@codecai/tool-kit": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "codec",
    "codec-tool-kit",
    "agent",
    "tool",
    "precache",
    "tokens-as-tokens"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wdunn001/Codec.git",
    "directory": "packages/codec-tool-kit/examples/time-tool"
  },
  "publishConfig": {
    "access": "public"
  }
}
